# ===== TikTok =====
# Fichero de cookies exportadas del navegador (obligatorio).
# Puede ser formato JSON (extensión .json) o Netscape/cookies.txt.
# Ver el README para instrucciones de exportación.
TIKTOK_COOKIES_FILE=/data/cookies.txt

# ===== Discord =====
# Token del Bot de Discord (https://discord.com/developers/applications).
DISCORD_BOT_TOKEN=
# ID numérico del canal donde se publican las alertas.
DISCORD_CHANNEL_ID=

# ===== Auditoría =====
# Cada cuántas horas se lanza la comprobación (por defecto: 6).
CHECK_INTERVAL_HOURS=6
# Retardo aleatorio extra (min) entre ciclos para evitar patrones fijos.
JITTER_MINUTES=30

# ===== Rutas (dentro del contenedor; no las cambies salvo que sepas) =====
DB_FILE=/data/audit.db

# ===== Opcional =====
TZ=Europe/Madrid
